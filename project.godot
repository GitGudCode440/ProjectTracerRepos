; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Area2D",
"class": "Bullet",
"language": "GDScript",
"path": "res://scripts/shared/Bullet.gd"
}, {
"base": "KinematicBody2D",
"class": "Character",
"language": "GDScript",
"path": "res://scripts/shared/Character.gd"
}, {
"base": "",
"class": "GitAPI",
"language": "NativeScript",
"path": "res://addons/godot-git-plugin/git_api.gdns"
}, {
"base": "State",
"class": "Run",
"language": "GDScript",
"path": "res://scripts/Player/States/Run.gd"
}, {
"base": "State",
"class": "Shoot",
"language": "GDScript",
"path": "res://scripts/Player/States/Shoot.gd"
}, {
"base": "Node",
"class": "State",
"language": "GDScript",
"path": "res://scripts/shared/StateMachine/State.gd"
}, {
"base": "Node",
"class": "StateMachine",
"language": "GDScript",
"path": "res://scripts/shared/StateMachine/state_machine.gd"
} ]
_global_script_class_icons={
"Bullet": "",
"Character": "",
"GitAPI": "",
"Run": "",
"Shoot": "",
"State": "",
"StateMachine": ""
}

[application]

config/name="Project Tracer"
run/main_scene="res://scenes/Game.tscn"
boot_splash/image="res://LoadingScreen.png"
config/icon="res://icon.png"

[autoload]

CameraShake="*res://singletons/CameraShake.gd"
AudioManager="*res://audio/AudioManager.tscn"

[display]

window/size/width=1280
window/size/height=720
window/size/resizable=false
window/vsync/vsync_via_compositor=true
mouse_cursor/custom_image="res://mouseCursor.png"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[gdnative]

singletons=[ "res://addons/godot-git-plugin/git_api.gdnlib" ]

[global]

"2d phys"=false
fps=false

